# Hikvision device
HIK_HOST=192.168.1.8
HIK_USER=admin
HIK_PASS=your_device_password_here
POLL_MS=30000

# PostgreSQL ERP database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=office_erp
DB_USER=postgres
DB_PASS=your_db_password_here

# Firebase — option A: path to downloaded service-account JSON
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Firebase — option B: paste values from service-account JSON directly
# (use option A OR B, not both)
# FIREBASE_PROJECT_ID=office-erp-c0a45
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@office-erp-c0a45.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
