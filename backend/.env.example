# ── Hikvision barrier / turnstile ──────────────────────────────────────────────
# LAN IP / hostname of the Hikvision access controller (DS-K3B411SX or compatible).
# This is a PRIVATE IP — the bridge script MUST run from a machine on the
# SAME office LAN (or VPN-connected) that can reach this IP.
HIK_HOST=192.168.1.8

# Web UI admin credentials. These are the SAME username/password you use to
# log into http://192.168.1.8 in your browser.
HIK_USER=admin
HIK_PASS=your_device_password_here

# How to authenticate to the device. Most Hikvision controllers use Digest
# auth (RFC 2617). If you get 401s, try "basic" or leave as "auto" which
# attempts Basic first, then falls back to Digest.
# Values: auto | digest | basic
HIK_AUTH_TYPE=auto

# Poll interval in ms (30000 = 30 seconds is recommended so as not to spam
# the device).
POLL_MS=30000

# ── Firebase / Firestore (MANDATORY) ──────────────────────────────────────────
# Either:
#   A) Drop your downloaded service-account JSON next to this .env file and
#      point to it with GOOGLE_APPLICATION_CREDENTIALS (RECOMMENDED), OR
#   B) Inline the three FIREBASE_* values below (useful for Docker/CI hosts).
#
# To get the JSON: Firebase Console → office-erp-c0a45 → Project Settings →
# Service Accounts → Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# FIREBASE_PROJECT_ID=office-erp-c0a45
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@office-erp-c0a45.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── ERP PostgreSQL database (OPTIONAL) ────────────────────────────────────────
# If filled, punches are ALSO written to the ERP relational DB in addition to
# Firestore. Firestore alone is enough for the web dashboard, so you can
# leave these blank for the initial setup.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=office_erp
DB_USER=postgres
DB_PASS=your_db_password_here

# ── Debug helpers ─────────────────────────────────────────────────────────────
# Set to 1 to print per-request auth headers + device responses to stderr.
# Useful if auth keeps failing; paste the output when asking for help.
# HIK_DEBUG=1
